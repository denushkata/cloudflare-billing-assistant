{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billing-reconciliation-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Front end; the Worker handles /api/* first and everything else falls through to these files.
  "assets": { "directory": "public", "run_worker_first": ["/api/*"] },
  // Workers AI always runs on Cloudflare, even under `wrangler dev`.
  "ai": { "binding": "AI", "remote": true },
  // SQLite-backed Durable Objects: one per customer (issue history, decisions, audit trail)
  // and one per reconciliation check (its calculated results and the chat about them).
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER", "class_name": "CustomerLedger" },
      { "name": "SESSION", "class_name": "ReviewSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CustomerLedger"] },
    { "tag": "v2", "new_sqlite_classes": ["ReviewSession"] }
  ],
  // Sample CSVs are bundled so the demo button needs no uploads.
  "rules": [{ "type": "Text", "globs": ["**/*.csv"], "fallthrough": true }]
}
